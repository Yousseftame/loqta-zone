rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "user") in ["admin", "superAdmin"];
    }

    function isRestricted(auctionId) {
      return exists(/databases/$(database)/documents/auctions/$(auctionId)/restricted/$(request.auth.uid));
    }
    
    

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAdmin();
      allow read:        if request.auth != null;

      match /notifications/{notifId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow update:       if request.auth != null && request.auth.uid == uid;

        allow create: if request.auth != null &&
          request.auth.uid == uid &&
          request.resource.data.type == "payment_confirmed" &&
          request.resource.data.keys().hasAll(["type", "auctionId", "title", "message", "isRead", "createdAt"]) &&
          request.resource.data.isRead == false;
      }

      match /auctions/{auctionId} {
        allow read:   if request.auth != null && (request.auth.uid == uid || isAdmin());
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update: if request.auth != null && request.auth.uid == uid;
        allow delete: if false;
      }
    }

    // ── Auction Requests ──────────────────────────────────────────────────────
    match /AuctionRequests/{requestId} {
      allow read, write: if isAdmin();
      allow read:        if request.auth != null && resource.data.userId == request.auth.uid;
      allow create:      if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == "pending";
    }

    // ── Auctions ──────────────────────────────────────────────────────────────
    match /auctions/{auctionId} {
      allow read: if true;
      allow create: if isAdmin();

      allow update: if request.auth != null && (
        (isAdmin() && resource.data.endTime > request.time) ||
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["winnerId", "winningBid", "updatedAt"])) ||
        (request.auth != null &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["totalParticipants"]) &&
          request.resource.data.totalParticipants == resource.data.totalParticipants + 1) ||
        (request.auth != null &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["currentBid", "totalBids"]) &&
          request.resource.data.currentBid > resource.data.currentBid &&
          request.resource.data.totalBids == resource.data.totalBids + 1 &&
          resource.data.endTime > request.time &&
          resource.data.isActive == true &&
          !isRestricted(auctionId)) ||
        (request.auth != null &&
          resource.data.get("bidType", "") == "decreasing" &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["currentBid", "totalBids", "endTime", "isActive"]) &&
          request.resource.data.totalBids == resource.data.totalBids + 1 &&
          resource.data.endTime > request.time &&
          resource.data.isActive == true &&
          !isRestricted(auctionId))
      );

      allow delete: if isAdmin();

      match /Participants/{userId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if false;
        allow delete: if isAdmin();
      }

      match /bids/{bidId} {
        allow read: if request.auth != null && (
          exists(/databases/$(database)/documents/auctions/$(auctionId)/Participants/$(request.auth.uid)) ||
          isAdmin()
        );
        allow create: if request.auth != null &&
          request.resource.data.userId == request.auth.uid &&
          exists(/databases/$(database)/documents/auctions/$(auctionId)/Participants/$(request.auth.uid)) &&
          !isRestricted(auctionId);
        allow update: if isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "selectedbyAdmin", "notifiedBidSelectedAt"]);
        allow delete: if isAdmin();
      }

      match /lastOffers/{offerId} {
        allow read, delete: if isAdmin();
        allow update: if isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "selectedbyAdmin", "notifiedLastOfferSelectedAt"]);
        allow read: if request.auth != null &&
          exists(/databases/$(database)/documents/auctions/$(auctionId)/Participants/$(request.auth.uid)) &&
          resource.data.userId == request.auth.uid;
        allow create: if request.auth != null &&
          exists(/databases/$(database)/documents/auctions/$(auctionId)/Participants/$(request.auth.uid)) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.status == "pending" &&
          request.resource.data.selectedbyAdmin == false;
      }

      match /chat/{chatId} {
        allow read: if request.auth != null && (
          exists(/databases/$(database)/documents/auctions/$(auctionId)/Participants/$(request.auth.uid)) ||
          isAdmin()
        );
        allow create: if request.auth != null &&
          request.resource.data.userId == request.auth.uid &&
          exists(/databases/$(database)/documents/auctions/$(auctionId)/Participants/$(request.auth.uid)) &&
          !isRestricted(auctionId);
        allow update, delete: if isAdmin();
      }

      match /restricted/{userId} {
        allow read:  if isAdmin() || (request.auth != null && request.auth.uid == userId);
        allow write: if isAdmin();
      }
    }
    
    


    // ── Products ──────────────────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Categories ────────────────────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

// ── Suppliers ──────────────────────────────────────────────────────────────
match /suppliers/{supplierId} {
  allow read: if true;
  allow write: if isAdmin();
}

    // ── Vouchers ──────────────────────────────────────────────────────────────
    match /vouchers/{voucherId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
      match /usages/{userId} {
        allow read:   if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create: if false;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // ── Contact Messages ──────────────────────────────────────────────────────
    match /contactMessages/{messageId} {
      allow create:               if true;
      allow read, update, delete: if isAdmin();
    }

    // ── Feedback Messages ─────────────────────────────────────────────────────
    match /feedbackMessages/{messageId} {
      allow create:               if true;
      allow read, update, delete: if isAdmin();
    }

    // ── Analytics ─────────────────────────────────────────────────────────────
    match /analytics/{docId} {
      // "dashboard" is readable by anyone — used on the public homepage stats section.
      // "topAuctions" contains financial data — admins only.
      allow read: if docId == "dashboard" || isAdmin();
      allow write: if false;
    }

    // ── Transactions ──────────────────────────────────────────────────────────
    match /transactions/{id} {
      allow read, create: if isAdmin();
      allow delete:       if isAdmin();
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "type", "amount", "method", "category", "note",
            "transferTo", "transferToAccountId", "accountId",
            "ownerId", "ownerName", "updatedBy", "updatedByName", "updatedAt"
          ]);
    }

    // ── Finance stats ─────────────────────────────────────────────────────────
    match /finance_stats/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ── Hero Slides ───────────────────────────────────────────────────────────
    match /heroSlides/{slideId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Left Section Slides ───────────────────────────────────────────────────
    match /leftSectionSlides/{slideId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Right Section Slides ──────────────────────────────────────────────────
    match /rightSectionSlides/{slideId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Audit Logs ────────────────────────────────────────────────────────────
    // Client-side audit logger writes from guests + all users — must never block login.
    match /auditLogs/{logId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    
    
      // ── Auction Support Tickets ───────────────────────────────────────────────
    match /auctionSupportTickets/{ticketId} {
      allow create:               if request.auth != null;
      allow read:                 if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update, delete:       if isAdmin();
    }
    
    // ── Payment Accounts ──────────────────────────────────────────────────────────
match /paymentAccounts/{accountId} {
  allow read, write: if isAdmin();
}
 
// ── Purchases ─────────────────────────────────────────────────────────────────
match /purchases/{purchaseId} {
  allow read, write: if isAdmin();

  // Payment audit trail (credit / partial payments)
  match /purchasePayments/{paymentId} {
    allow read, write: if isAdmin();
  }
}

// ── Owners ────────────────────────────────────────────────────────────────────
match /owners/{ownerId} {
  allow read, write: if isAdmin();
}




  }
}
